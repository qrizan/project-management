# Versi seluruh komponen platform, dikumpulkan di satu tempat supaya perubahan
# versi terlihat sebagai satu baris diff, bukan tersebar di beberapa script.
#
# Versi node image kind ada di k8s/kind-cluster.yaml, versi metrics-server ada
# di k8s/platform/metrics-server/kustomization.yaml. Keduanya dipatok di
# manifestnya sendiri, tidak diduplikasi di sini. Begitu juga nama cluster
# kind, yang dibaca lib.sh langsung dari k8s/kind-cluster.yaml.

CERT_MANAGER_VERSION=v1.21.1
CNPG_VERSION=1.30.0
BARMAN_PLUGIN_VERSION=v0.14.0
ENVOY_GATEWAY_VERSION=v1.8.3
CLOUD_PROVIDER_KIND_VERSION=v0.11.1
KUBE_PROMETHEUS_STACK_VERSION=88.3.0

APP_NAMESPACE=project-management
GARAGE_NAMESPACE=garage
MONITORING_NAMESPACE=monitoring
KUBE_PROMETHEUS_STACK_RELEASE=kube-prometheus-stack

APP_IMAGE_BUILDER=project-management-app:builder
APP_IMAGE_RUNNER=project-management-app:runner

ARGOCD_VERSION=v3.5.1